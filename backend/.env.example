# ---------------------------------------------------------------------------
# EzCommerce API (LaRust 0.10)
# Copia este archivo a `.env` y ajusta los valores.
# ---------------------------------------------------------------------------

APP_NAME="EzCommerce"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://127.0.0.1:34187
APP_PORT=34187
API_PREFIX=/api
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_CURRENCY=EUR

# ---------------------------------------------------------------------------
# Base de datos
#   SQLite (por defecto, desarrollo)
#   MySQL / MariaDB (producción)
# ---------------------------------------------------------------------------
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ezcommerce
# DB_USERNAME=ezcommerce
# DB_PASSWORD=secret
# DB_CHARSET=utf8mb4

# ---------------------------------------------------------------------------
# Autenticación JWT (shop API + admin API)
# ---------------------------------------------------------------------------
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_BLACKLIST_ENABLED=true
PASSWORD_RESET_EXPIRE=60

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:8080
FRONTEND_WWW_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Correo
#   MAIL_MAILER=log    -> escribe el correo en el log (desarrollo)
#   MAIL_MAILER=smtp   -> usa MAIL_HOST/PORT/USERNAME/PASSWORD
#   MAIL_MAILER=resend -> usa la API HTTP de Resend con RESEND_API_KEY
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS=shop@example.com
MAIL_FROM_NAME="EzCommerce"
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Logs / colas / caché (valores por defecto de LaRust)
# ---------------------------------------------------------------------------
LOG_CHANNEL=stdout
LOG_LEVEL=
LOG_MAX_SIZE=10485760
LOG_KEEP_FILES=5
QUEUE_DRIVER=database
CACHE_DRIVER=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true

# ---------------------------------------------------------------------------
# Datos iniciales (`migrate:fresh --seed`)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
# false = no crear datos de ejemplo (categorías/productos demo)
SEED_DEMO_DATA=true
